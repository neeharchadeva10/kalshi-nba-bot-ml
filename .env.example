# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# Phase 1 (historical research) needs NO credentials: Kalshi market data and
# Polymarket public APIs are unauthenticated.
#
# Execution (kpm exec, kpm bot). KALSHI_ENV is REQUIRED and has no default: exactly "demo" or "prod".
#   * Watch-only (the default of `kpm bot run`) needs no keys at all: set KALSHI_ENV=prod to watch the real markets.
#   * `kpm exec check` and `kpm exec reconcile` read the account, so they need the selected environment's key pair.
#   * Live trading (`kpm bot run --live --env prod`) needs KALSHI_ENV=prod, the production key pair below,
#     trading.enabled: true in config/settings.yaml, and the typed confirmation.
# Only the names below are read, and their values are never printed or logged (the key fingerprint is the only
# identifier that is shown: the first 8 hex digits of the SHA-256 of the key id).
KALSHI_ENV=
# Production (Ed25519 or RSA key). Keep the PEM file OUTSIDE the repo; only its path goes here.
KALSHI_PROD_KEY_ID=
KALSHI_PROD_KEY_PATH=
# KALSHI_PROD_KEY_PASSWORD=            (only if the PEM is encrypted)
# Older single pair, still read for prod when the KALSHI_PROD_* names above are empty:
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Demo (separate account and key; it only works on the demo hosts). Never reads the prod or legacy names.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_KEY_PATH=
# KALSHI_DEMO_KEY_PASSWORD=

# Only used if matcher.review_backend = "claude_api" AND matcher.allow_paid_api = true
ANTHROPIC_API_KEY=
